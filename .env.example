# Copy to .env for local development. Never commit .env.
# Load it into your shell with:  set -a; source .env; set +a

# SQLite locally; on Render use the Neon connection string (postgresql://...).
DATABASE_URL=sqlite:///./slotwise.db

# Signs the owner session cookie. Required when DATABASE_URL is not SQLite.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Shared secret for POST /internal/run-jobs (used from slice 5).
JOBS_SECRET=change-me

# Optional. Without it, emails are printed to the log instead of being sent.
EMAIL_API_KEY=

# The owner account, created on startup when no owner exists yet.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-local-only

# true = seed the Isar Wellness demo menu, therapists, @example.com customers and
# about 20 bookings, but only when the studio table is still empty.
SEED_DEMO_DATA=true

# RENDER_GIT_COMMIT is set by Render on every deploy and shown as the version in
# GET /health. Leave it unset locally (the version is then "dev").
